# FloatCTF API (native process) — Phase 10.6.
# 最小能力原则：仅 CAP_NET_ADMIN（AWD HostNetworkRuntime 管理 nftables/WireGuard/
# Docker 转发的底线）。绝不 PrivateNetwork —— API 必须操作宿主网络。
# 配置只从 TOML 读取（铁律 1）：FLOATCTF_CONFIG 指向 /home/floatctf/config/floatctf.toml。
[Unit]
Description=FloatCTF API
Requires=floatctf-infra.service
After=floatctf-infra.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=floatctf
Group=floatctf
SupplementaryGroups=docker
WorkingDirectory=/home/floatctf/runtime
EnvironmentFile=/home/floatctf/.env
Environment=FLOATCTF_CONFIG=/home/floatctf/config/floatctf.toml
ExecStart=/home/floatctf/bin/floatctf
Restart=on-failure
RestartSec=5
# AWD host runtime 需要 CAP_NET_ADMIN（nftables / WireGuard / docker forward 管理）。
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=no
# 明确不设 PrivateNetwork/PrivateTmp 隔离 —— API 必须访问宿主网络命名空间。

[Install]
WantedBy=floatctf.target
