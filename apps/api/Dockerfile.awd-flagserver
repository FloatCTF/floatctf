# FlagServer binary for AWD infrastructure network.
FROM rust:1.89.0-slim-bookworm AS builder
WORKDIR /app
ENV CARGO_HOME=/usr/local/cargo
RUN mkdir -p $CARGO_HOME
COPY rsproxy.conf.toml $CARGO_HOME/config.toml 2>/dev/null || true
COPY sources.list /etc/apt/sources.list 2>/dev/null || true
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY fcmc ./fcmc
COPY src ./src
# Minimal dummy for cookbook if needed
RUN cargo build --release --bin awd_flagserver

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/awd_flagserver /usr/local/bin/awd_flagserver
ENV LISTEN_ADDR=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/awd_flagserver"]
