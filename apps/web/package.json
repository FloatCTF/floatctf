{
  "name": "@floatctf/web",
  "version": "1.0.0",
  "private": true,
  "description": "FloatCTF web bootstrap: resolves the installed frontend and mounts it. Intentionally boring and React-free.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "build:bootstrap": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check"
  },
  "dependencies": {
    "@floatctf/frontend-runtime": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.5"
  }
}
