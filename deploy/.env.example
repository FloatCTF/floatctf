# FloatCTF 生产 Compose 的部署元数据（不是业务配置；业务配置在 config/floatctf.toml）。
# 用法：cp .env.example .env && 改掉所有 CHANGE_ME，然后 docker compose -f compose.prod.yml up -d

# ── 必填 ─────────────────────────────────────────────────────────────────────
# 平台版本 = release tag 去掉前导 v；决定镜像 tag 与迁移版本
VERSION=CHANGE_ME
# 安装根目录（绝对路径）；compose 的 bind mount 都挂在它下面
FLOATCTF_HOME=/var/lib/floatctf
# API 容器身份：UID 固定 65532，GID = 宿主 floatctf 组的 GID（getent group floatctf）
FLOATCTF_UID=65532
FLOATCTF_GID=CHANGE_ME

# 站点域名（Caddy 用它签证书；必须能解析到本机且 80/443 可达）
SITE_ADDRESS=ctf.example.com

# ── 镜像 ─────────────────────────────────────────────────────────────────────
# 默认拉 GHCR 发布镜像；想用本地构建的镜像就改成 floatctf/api:<VERSION>
API_IMAGE=ghcr.io/floatctf/floatctf-api:CHANGE_ME

# ── 数据库 / 对象存储 ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=floatctf_db
POSTGRES_PASSWORD=CHANGE_ME
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=CHANGE_ME

# ── 端口（默认都只绑 127.0.0.1，不对外）──────────────────────────────────────
HOST_ADDRESS=127.0.0.1
API_PORT=9090
POSTGRES_PORT=5433
REDIS_PORT=6380
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
HTTP_PORT=80
HTTPS_PORT=443
